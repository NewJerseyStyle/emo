{
  "name": "@cache-aware/opencode-cache-compaction",
  "version": "0.1.0",
  "description": "Cache-aware context compaction for OpenCode: reduces cold-start cost at ULW/ulw-loop handoff points",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "postinstall.mjs"],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/orchestrator/task-context.ts --outdir dist --target node --format esm",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "node postinstall.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.27",
    "@opencode-ai/sdk": "^1.18.27"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
