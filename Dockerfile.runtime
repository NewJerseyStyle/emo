# Dockerfile.runtime — run opencode with the cache-compaction plugin against a
# real LLM (InternalQwen), default qwen model, NO oh-my-opencode installed.
#
# Verifies: plugin loads, runs stably, and shows the omo setup prompt when omo
# is absent.
#
# Build: podman build -f Dockerfile.runtime -t cache-compaction-runtime .
# Run:   podman run --rm cache-compaction-runtime

FROM oven/bun:1.4 AS build
WORKDIR /app
COPY package.json bun.lock postinstall.mjs ./
COPY src ./src
COPY tsconfig.json ./
RUN bun install --ignore-scripts && bun run build

# Stage holding the standalone opencode binary (copied from the host).
FROM scratch AS opencode
COPY test/runtime/bin/opencode /opencode

# --- runtime stage ---
FROM node:22-slim

# Install git (needed by the HL repo layer) + a deterministic identity.
RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system user.name "cache-compaction-test" \
    && git config --system user.email "cache-compaction-test@example.com"

# Copy the standalone opencode binary from the host (pinned to the dev version).
COPY --from=opencode /opencode /usr/local/bin/opencode
RUN chmod +x /usr/local/bin/opencode

WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY package.json ./
COPY postinstall.mjs ./

# Configure opencode: InternalQwen provider, default qwen model, NO omo.
RUN mkdir -p /root/.config/opencode
COPY test/runtime/opencode.json /root/.config/opencode/opencode.json

# Install the built plugin into opencode's config as a local package.
# Reuse the build stage's node_modules (no network access needed).
COPY package.json /tmp/plugin/package.json
COPY dist /tmp/plugin/dist
COPY postinstall.mjs /tmp/plugin/postinstall.mjs
COPY --from=build /app/node_modules /tmp/plugin/node_modules
RUN node -e "const p=require('/tmp/plugin/package.json');p.name='@cache-aware/opencode-cache-compaction';require('fs').writeFileSync('/tmp/plugin/package.json',JSON.stringify(p,null,2))"

# Run the runtime test.
COPY test/runtime/run-test.sh /app/run-test.sh
RUN chmod +x /app/run-test.sh

# Compaction test: verifies task-aware context extraction works against the
# real LLM (the core of the compression mechanism in the no-omo case).
COPY test/runtime/test-compaction.mjs /app/test-compaction.mjs

CMD ["/app/run-test.sh"]